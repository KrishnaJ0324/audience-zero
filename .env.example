# Copy to .env to configure. All keys are prefixed AZ_ (pydantic-settings).
# With no key set, the project runs fully offline in deterministic "mock" mode.

# provider: auto | mock | openai
#   auto  -> openai if a key is present, else mock (default)
#   mock  -> deterministic, offline, no key/ffmpeg needed
#   openai-> real LLM/STT/TTS
AZ_PROVIDER=auto

# Real OpenAI key (only used when provider resolves to openai)
# You can also set the standard OPENAI_API_KEY instead.
AZ_OPENAI_API_KEY=

# Theatre pacing: seconds between per-beat reveal events (curve animation)
AZ_REVEAL_DELAY_S=0.18

# Per-agent timeout / retries
AZ_PER_AGENT_TIMEOUT_S=60
AZ_PER_AGENT_RETRIES=1
